{
  "name": "chemomer",
  "version": "0.1.3",
  "description": "Native Rust InChI engine for Node — molfile in, identifier / AuxInfo / InChIKey out (the napi binding)",
  "keywords": [
    "inchi",
    "inchikey",
    "chemistry",
    "cheminformatics",
    "napi-rs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chemomer/chemomer-ts.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "chemomer-darwin-arm64": "0.1.3",
    "chemomer-darwin-x64": "0.1.3",
    "chemomer-linux-x64-gnu": "0.1.3",
    "chemomer-win32-x64-msvc": "0.1.3"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dir -t .",
    "build": "napi build --platform --release --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --js index.js --dts index.d.ts",
    "test": "npm run build:debug && node scripts/smoke-napi.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "napi": {
    "name": "index",
    "triples": {
      "additional": [
        "aarch64-apple-darwin"
      ]
    }
  }
}
